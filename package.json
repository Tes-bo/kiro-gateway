{
	"name": "kiro-gateway",
	"displayName": "Kiro Gateway",
	"description": "Route Kiro's built-in chat through your own API key, JSON login, or an Anthropic-compatible relay.",
	"version": "2.0.7",
	"publisher": "tesbo",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Tes-bo/kiro-gateway.git"
	},
	"homepage": "https://github.com/Tes-bo/kiro-gateway#readme",
	"bugs": {
		"url": "https://github.com/Tes-bo/kiro-gateway/issues"
	},
	"icon": "media/logo.png",
	"engines": {
		"vscode": "^1.94.0"
	},
	"categories": [
		"Other",
		"Machine Learning"
	],
	"keywords": [
		"kiro",
		"apikey",
		"ksk",
		"json",
		"gateway",
		"proxy",
		"relay",
		"anthropic"
	],
	"activationEvents": [
		"onStartupFinished",
		"*"
	],
	"main": "./extension.js",
	"scripts": {
		"build:webview": "npm --prefix webview-ui install --no-audit --no-fund && npm --prefix webview-ui run build:prod",
		"package": "npx --yes @vscode/vsce@latest package --allow-star-activation"
	},
	"contributes": {
		"commands": [
			{
				"command": "kiroGateway.openPanel",
				"title": "Open Control Panel",
				"category": "Kiro Gateway",
				"icon": "$(rocket)"
			},
			{
				"command": "kiroGateway.toggle",
				"title": "Toggle Gateway",
				"category": "Kiro Gateway"
			},
			{
				"command": "kiroGateway.test",
				"title": "Test API Key",
				"category": "Kiro Gateway"
			},
			{
				"command": "kiroGateway.reloadWindow",
				"title": "Reload Window",
				"category": "Kiro Gateway"
			},
			{
				"command": "kiroGateway.importJsonFiles",
				"title": "Import JSON Credential Files",
				"category": "Kiro Gateway"
			},
			{
				"command": "kiroGateway.switchMode",
				"title": "Switch Mode (Direct Key / Relay)",
				"category": "Kiro Gateway"
			},
			{
				"command": "kiroGateway.livenessCheckNow",
				"title": "Check Key Liveness Now",
				"category": "Kiro Gateway"
			},
			{
				"command": "kiroGateway.toggleAutoAllow",
				"title": "Toggle Agent Auto-Allow",
				"category": "Kiro Gateway"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "kiroGateway",
					"title": "Kiro Gateway",
					"icon": "icon.png"
				}
			]
		},
		"views": {
			"kiroGateway": [
				{
					"type": "webview",
					"id": "kiroGateway.controlPanel",
					"name": "Gateway",
					"icon": "media/logo.png"
				}
			]
		},
		"configuration": {
			"title": "Kiro Gateway",
			"properties": {
				"codewhisperer.config.krsEndpoints": {
					"type": "array",
					"description": "%kiroGateway.nls.0%",
					"default": [],
					"items": {
						"type": "object",
						"properties": {
							"region": { "type": "string" },
							"endpoint": { "type": "string" }
						}
					}
				},
				"codewhisperer.config.cpsEndpoints": {
					"type": "array",
					"description": "%kiroGateway.nls.1%",
					"default": [],
					"items": {
						"type": "object",
						"properties": {
							"region": { "type": "string" },
							"endpoint": { "type": "string" }
						}
					}
				},
				"kiroGateway.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%kiroGateway.nls.43%"
				},
				"kiroGateway.apiKeys": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "%kiroGateway.nls.44%"
				},
				"kiroGateway.activeApiKey": {
					"type": "string",
					"default": "",
					"description": "%kiroGateway.nls.45%"
				},
				"kiroGateway.apiKey": {
					"type": "string",
					"default": "",
					"description": "%kiroGateway.nls.46%"
				},
				"kiroGateway.region": {
					"type": "string",
					"default": "us-east-1",
					"description": "%kiroGateway.nls.47%"
				},
				"kiroGateway.ports": {
					"type": "object",
					"default": {
						"krs": 19820,
						"cps": 19821
					},
					"description": "%kiroGateway.nls.48%"
				},
				"kiroGateway.livenessCheckEnabled": {
					"type": "boolean",
					"default": false,
					"description": "%kiroGateway.nls.2%"
				},
				"kiroGateway.livenessCheckIntervalSec": {
					"type": "number",
					"default": 60,
					"description": "%kiroGateway.nls.3%"
				},
				"kiroGateway.livenessRealCheckPerKeyIntervalSec": {
					"type": "number",
					"default": 60,
					"description": "%kiroGateway.nls.4%"
				},
				"kiroGateway.autoDeleteOnDead": {
					"type": "boolean",
					"default": true,
					"description": "%kiroGateway.nls.5%"
				},
				"kiroGateway.autoAllow.enabled": {
					"type": "boolean",
					"default": false,
					"description": "%kiroGateway.nls.6%"
				},
				"kiroGateway.preferredEndpoint": {
					"type": "string",
					"enum": [
						"krs",
						"q"
					],
					"enumDescriptions": [
						"%kiroGateway.nls.8%",
						"%kiroGateway.nls.9%"
					],
					"default": "krs",
					"description": "%kiroGateway.nls.7%"
				},
				"kiroGateway.endpointFallback": {
					"type": "boolean",
					"default": true,
					"description": "%kiroGateway.nls.10%"
				},
				"kiroGateway.endpointCooldownMs": {
					"type": "number",
					"default": 5000,
					"description": "%kiroGateway.nls.11%"
				},
				"kiroGateway.endpointRounds": {
					"type": "number",
					"default": 2,
					"description": "%kiroGateway.nls.12%"
				},
				"kiroGateway.endpointRoundDelayMs": {
					"type": "number",
					"default": 1500,
					"description": "%kiroGateway.nls.13%"
				},
				"kiroGateway.throttleRetryForever": {
					"type": "boolean",
					"default": true,
					"description": "%kiroGateway.nls.14%"
				},
				"kiroGateway.throttleBackoffCapMs": {
					"type": "number",
					"default": 30000,
					"description": "%kiroGateway.nls.15%"
				},
				"kiroGateway.serverErrorRetry": {
					"type": "boolean",
					"default": true,
					"description": "%kiroGateway.nls.16%"
				},
				"kiroGateway.serverErrorRetryMax": {
					"type": "number",
					"default": 5,
					"description": "%kiroGateway.nls.17%"
				},
				"kiroGateway.language": {
					"type": "string",
					"enum": ["auto", "zh", "en"],
					"enumDescriptions": [
						"%kiroGateway.nls.50%",
						"%kiroGateway.nls.51%",
						"%kiroGateway.nls.52%"
					],
					"default": "auto",
					"description": "%kiroGateway.nls.49%"
				},
				"kiroGateway.mode": {
					"type": "string",
					"enum": [
						"official",
						"relay"
					],
					"enumDescriptions": [
						"%kiroGateway.nls.19%",
						"%kiroGateway.nls.20%"
					],
					"default": "official",
					"description": "%kiroGateway.nls.18%"
				},
				"kiroGateway.relayBaseUrl": {
					"type": "string",
					"default": "",
					"description": "%kiroGateway.nls.21%"
				},
				"kiroGateway.relayApiKey": {
					"type": "string",
					"default": "",
					"description": "%kiroGateway.nls.22%"
				},
				"kiroGateway.relayPorts": {
					"type": "object",
					"default": {
						"krs": 19830,
						"cps": 19831
					},
					"description": "%kiroGateway.nls.23%"
				},
				"kiroGateway.relayMaxTokens": {
					"type": "number",
					"default": 32000,
					"description": "%kiroGateway.nls.24%"
				},
				"kiroGateway.relayThinking": {
					"type": "string",
					"enum": [
						"auto",
						"enabled",
						"disabled"
					],
					"enumDescriptions": [
						"%kiroGateway.nls.26%",
						"%kiroGateway.nls.27%",
						"%kiroGateway.nls.28%"
					],
					"default": "auto",
					"description": "%kiroGateway.nls.25%"
				},
				"kiroGateway.relayThinkingBudget": {
					"type": "number",
					"default": 8192,
					"description": "%kiroGateway.nls.29%"
				},
				"kiroGateway.relayEffortMode": {
					"type": "string",
					"enum": [
						"auto",
						"modelVariant",
						"thinkingBudget",
						"off"
					],
					"enumDescriptions": [
						"%kiroGateway.nls.31%",
						"%kiroGateway.nls.32%",
						"%kiroGateway.nls.33%",
						"%kiroGateway.nls.34%"
					],
					"default": "auto",
					"description": "%kiroGateway.nls.30%"
				},
				"kiroGateway.relayEffortBudgets": {
					"type": "object",
					"default": {
						"low": 2048,
						"medium": 4096,
						"high": 8192,
						"xhigh": 16384,
						"max": 24576
					},
					"description": "%kiroGateway.nls.35%"
				},
				"kiroGateway.relayModelMapping": {
					"type": "object",
					"default": {},
					"description": "%kiroGateway.nls.37%"
				},
				"kiroGateway.relayInterceptIntentClassifier": {
					"type": "boolean",
					"default": true,
					"description": "%kiroGateway.nls.38%"
				},
				"kiroGateway.relayPromptCaching": {
					"type": "string",
					"enum": [
						"auto",
						"all",
						"off"
					],
					"enumDescriptions": [
						"%kiroGateway.nls.40%",
						"%kiroGateway.nls.41%",
						"%kiroGateway.nls.42%"
					],
					"default": "auto",
					"description": "%kiroGateway.nls.39%"
				}
			}
		}
	}
}
